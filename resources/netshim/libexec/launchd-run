#!/bin/sh
# launchd-run <program> [args...]: runs <program> as a one-off launchd job.
#
# macOS 27 shows 02:00:00:00:00:00 instead of real MAC addresses to processes started
# by an app without a Developer ID, and Termflow's shells are such processes. A process
# that launchd starts is not, so the network tools in ../bin run the real program here.
# Its output is passed through untouched; Ctrl+C and the exit code behave as usual.
# If anything in the setup fails, the program simply runs directly.
real=$1; shift
[ "$(id -u)" = 0 ] && exec "$real" "$@"
dir=$(mktemp -d "${TMPDIR:-/tmp}/termflow-net.XXXXXX") || exec "$real" "$@"
domain=gui/$(id -u)
label=io.github.pluemsuthiwat.termflow.net.${dir##*.}
plist=$dir/job.plist
fallback() { rm -rf "$dir"; exec "$real" "$@"; }

# On a terminal, the job reads our tty through `script`, which gives the program a pty
# of its own: it sees a terminal (line-by-line output, e.g. `netstat -w 1`) and Ctrl+C
# reaches it. `script` sets our tty to raw mode while it runs; we put it back after.
tty= saved=
if [ -t 0 ] && [ -t 1 ]; then tty=$(tty) && saved=$(stty -g) || tty=; fi
if [ -n "$tty" ]; then in=$tty pre='/usr/bin/script -q /dev/null'; else in=/dev/null pre=; fi

cleanup() {
  launchctl bootout "$domain/$label" 2>/dev/null
  [ -n "$saved" ] && stty "$saved" 2>/dev/null
  [ -n "$pids" ] && kill $pids 2>/dev/null
  rm -rf "$dir"
}

mkfifo "$dir/out" "$dir/err" || fallback "$@"
plutil -create xml1 "$plist" &&
  plutil -insert Label -string "$label" "$plist" &&
  plutil -insert RunAtLoad -bool YES "$plist" &&
  plutil -insert StandardInPath -string "$in" "$plist" &&
  plutil -insert StandardOutPath -string "$dir/out" "$plist" &&
  plutil -insert StandardErrorPath -string "$dir/err" "$plist" &&
  plutil -insert ProgramArguments -array "$plist" || fallback "$@"
# The inner sh records the exit code (130 after Ctrl+C, like a shell would report).
for a in $pre /bin/sh -c 'trap : INT; "$@"; echo $? >"$0"' "$dir/status" "$real" "$@"; do
  plutil -insert ProgramArguments -string "$a" -append "$plist" || fallback "$@"
done
launchctl bootstrap "$domain" "$plist" 2>/dev/null || fallback "$@"

trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM HUP
# In the background so `wait` can be interrupted by the traps above.
cat "$dir/err" >&2 & pids=$!
cat "$dir/out" & pids="$pids $!"
wait
pids=
code=$(cat "$dir/status" 2>/dev/null)
cleanup
exit "${code:-1}"
