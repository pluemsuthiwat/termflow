TERMFLOW_ZDOTDIR=$ZDOTDIR
ZDOTDIR=$TERMFLOW_USER_ZDOTDIR
[[ -f $ZDOTDIR/.zlogin ]] && source $ZDOTDIR/.zlogin
TERMFLOW_USER_ZDOTDIR=$ZDOTDIR
ZDOTDIR=$TERMFLOW_ZDOTDIR

# Last startup file: from here on (and in shells started from this one) zsh is as usual.
if [[ -n $TERMFLOW_ZDOTDIR_SET || $TERMFLOW_USER_ZDOTDIR != $HOME ]]; then
  export ZDOTDIR=$TERMFLOW_USER_ZDOTDIR
else
  unset ZDOTDIR
fi
unset TERMFLOW_ZDOTDIR TERMFLOW_USER_ZDOTDIR TERMFLOW_ZDOTDIR_SET TERMFLOW_NETSHIM_BIN
